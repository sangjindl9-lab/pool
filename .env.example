# 서버 포트
PORT=3000

# 처음 실행할 때 이 계정으로 관리자가 만들어집니다 (비밀번호 8자 이상)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=여기에-강한-비밀번호

# nginx 등 리버스 프록시 뒤에서 운영하면 1 (실제 접속 IP를 읽기 위해 꼭 필요)
TRUST_PROXY=1

# HTTPS(자물쇠)로 운영하면 1
COOKIE_SECURE=1

# 데이터베이스 저장 폴더 (기본: ./data)
# DATA_DIR=/var/lib/chakgong

# 로그인 유지 기간(일)
SESSION_DAYS=30
